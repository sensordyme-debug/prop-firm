# Copy to .env and fill in. .env is gitignored and must never be committed.
# Placeholder values below are DETECTED AS PLACEHOLDERS: the system treats them
# as "no credentials" rather than sending junk to the API.

# ---------------------------------------------------------------------------
# TOPSTEP / PROJECTX
# ---------------------------------------------------------------------------
# PROJECT_X_USERNAME is the TopstepX USERNAME, not the email you log in with.
# Generate the key AFTER linking ProjectX to TopstepX -- a key made before
# linking authenticates but resolves to no tradable account.
PROJECT_X_API_KEY=paste_your_key_here
PROJECT_X_USERNAME=your_topstepx_username
# Optional: pin one account instead of the default.
# PROJECT_X_ACCOUNT_NAME=your_combine_account_name

# ---------------------------------------------------------------------------
# EXECUTION GATING  -- two keys, opposite polarity, both must agree
# ---------------------------------------------------------------------------
# Order transmission is NOT IMPLEMENTED. These cannot enable it: the config
# layer rejects LIVE_TRADING_ENABLED=true outright, and the broker adapter has
# no order method to call. Enabling execution is a reviewed code change after
# the ROADMAP Stage 5 gates are demonstrated, never an .env edit.
DRY_RUN=true
LIVE_TRADING_ENABLED=false

# ---------------------------------------------------------------------------
# TRADING
# ---------------------------------------------------------------------------
SYMBOL=MNQ
POSITION_SIZE=2

# ---------------------------------------------------------------------------
# RISK  (dollars; deliberately far inside Topstep's own limits)
# ---------------------------------------------------------------------------
RISK_PER_TRADE=80
DAILY_MAX_LOSS=250
DAILY_PROFIT_TARGET=500
FLOOR_BUFFER=400
MAX_TRADES_PER_SESSION=2

# The tracked trailing MLL floor. NOT available from the API -- read it from
# the TopstepX dashboard and seed it:
#   python -m src.cli mll --seed --mll 48000
# MLL_FLOOR=48000

# ---------------------------------------------------------------------------
# TIMING  (all America/New_York wall clock)
# ---------------------------------------------------------------------------
# Topstep requires flat by 16:10 ET and their desk starts flattening at 16:08.
# 15:55 leaves 13 minutes. Do not move this later.
TIMEZONE=America/New_York
SESSION_START=18:00
RTH_OPEN=09:30
ENTRY_CUTOFF=11:30
HARD_FLATTEN=15:55
STALE_DATA_SECONDS=120
