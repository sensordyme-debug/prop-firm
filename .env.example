# ProjectX / TopstepX credentials - never commit the real .env
PROJECT_X_API_KEY=paste_your_key_here
PROJECT_X_USERNAME=your_topstepx_username

# Optional: pin a specific account instead of the default
# PROJECT_X_ACCOUNT_NAME=your_combine_account_name

# Safety switch. Leave true until the overnight rehearsal has been reviewed.
DRY_RUN=true

# Risk envelope (dollars). Deliberately far inside Topstep own limits.
DAILY_PROFIT_TARGET=500
DAILY_MAX_LOSS=250
RISK_PER_TRADE=80
FLOOR_BUFFER=400

# Position size in MNQ contracts. Do not raise without clearing the go-live gates.
POSITION_SIZE=2
